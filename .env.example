# Salin ke .env.local selepas projek Supabase dicipta.
# URL projek bermula dengan https:// dan tidak menggunakan awalan db.
# Nilai kedua ialah kunci publishable (sb_publishable_...), bukan secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API untuk ekstraksi rekod darah: Mistral OCR + Nous Research sahaja.
# Kedua-dua kunci diperlukan pada environment pelayan Netlify.
MISTRAL_API_KEY=
NOUS_API_KEY=
NOUS_API_BASE_URL=https://inference-api.nousresearch.com/v1
NOUS_LAB_MODEL=Hermes-4-70B
