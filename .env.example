# Salin ke .env.local selepas projek Supabase dicipta.
# URL projek bermula dengan https:// dan tidak menggunakan awalan db.
# Nilai kedua ialah kunci publishable (sb_publishable_...), bukan secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API ekstraksi rekod darah: OpenAI GPT-4o Vision sahaja.
# Simpan kunci ini pada environment pelayan Netlify; jangan dedahkan di browser.
OPENAI_API_KEY=
OPENAI_LAB_MODEL=gpt-4o
