# Salin ke .env.local selepas projek Supabase dicipta.
# URL projek bermula dengan https:// dan tidak menggunakan awalan db.
# Nilai kedua ialah kunci publishable (sb_publishable_...), bukan secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kunci Gemini hanya pada pelayan. Jangan guna awalan NEXT_PUBLIC_.
# Dapatkan di https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Pilihan. Lalai gemini-3.8-flash. Hanya gemini-3.8-flash, gemini-3.6-flash, atau gemini-2.5-flash.
GEMINI_MODEL=

# Primary lab extraction: Mistral OCR + Nous Research structuring
MISTRAL_API_KEY=
NOUS_API_KEY=
NOUS_API_BASE_URL=https://inference-api.nousresearch.com/v1
NOUS_LAB_MODEL=Hermes-4-70B

# Optional fallback: OpenAI structures OCR text if Nous and Gemini fail
OPENAI_API_KEY=
OPENAI_LAB_MODEL=gpt-4.1
